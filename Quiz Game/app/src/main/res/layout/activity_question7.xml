<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/question_bg"
    tools:context=".question7">

    <TextView
        android:id="@+id/textView"
        android:layout_width="323dp"
        android:layout_height="123dp"
        android:layout_marginTop="40dp"
        android:text="Which is the largest planet in our Solar System?"
        android:textAlignment="center"
        android:textColor="#F0EBEB"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/q7op1"
        android:layout_width="240dp"
        android:layout_height="65dp"
        android:backgroundTint="#182B63"
        android:text="Earth"
        android:textColor="#EDE6E6"
        android:textSize="24sp"
        android:textStyle="bold"
        app:cornerRadius="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/textView"
        app:layout_constraintVertical_bias="0.228"
        app:rippleColor="#2196F3"
        app:strokeColor="#EDE4E4"
        app:strokeWidth="2dp" />

    <Button
        android:id="@+id/q7op2"
        android:layout_width="240dp"
        android:layout_height="65dp"
        android:backgroundTint="#182B63"
        android:text="Mars"
        android:textColor="#EDE6E6"
        android:textSize="24sp"
        android:textStyle="bold"
        app:cornerRadius="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/textView"
        app:layout_constraintVertical_bias="0.37"
        app:rippleColor="#2196F3"
        app:strokeColor="#EBDFDF"
        app:strokeWidth="2dp" />

    <Button
        android:id="@+id/q7op3"
        android:layout_width="240dp"
        android:layout_height="65dp"
        android:backgroundTint="#182B63"
        android:text="Jupiter"
        android:textColor="#EDE6E6"
        android:textSize="24sp"
        android:textStyle="bold"
        app:cornerRadius="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/textView"
        app:layout_constraintVertical_bias="0.525"
        app:rippleColor="#2196F3"
        app:strokeColor="#EDE8E8"
        app:strokeWidth="2dp" />

    <Button
        android:id="@+id/q7op4"
        android:layout_width="240dp"
        android:layout_height="65dp"
        android:backgroundTint="#182B63"
        android:text="Venus"
        android:textColor="#EDE6E6"
        android:textSize="24sp"
        android:textStyle="bold"
        app:cornerRadius="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/textView"
        app:layout_constraintVertical_bias="0.669"
        app:rippleColor="#2196F3"
        app:strokeColor="#EBDDDD"
        app:strokeWidth="2dp" />

    <!-- RESULT -->

    <!-- PREV / NEXT -->

    <TextView
        android:id="@+id/textView2"
        android:layout_width="245dp"
        android:layout_height="52dp"
        android:layout_marginBottom="52dp"
        android:textAlignment="center"
        android:textSize="34sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/linearLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.518"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="310dp"
        android:layout_height="46dp"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.752"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/q7_prev"
            android:layout_width="145dp"
            android:layout_height="50dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#FFB52E"
            android:text="PREV"
            android:textColor="#050505"
            android:textSize="20sp"
            android:textStyle="bold"
            app:cornerRadius="15dp"
            app:rippleColor="#FF5722" />

        <Button
            android:id="@+id/q7_nxt"
            android:layout_width="145dp"
            android:layout_height="50dp"
            android:layout_marginEnd="40dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#FFB52E"
            android:text="NEXT"
            android:textColor="#0D0C0C"
            android:textSize="20sp"
            android:textStyle="bold"
            app:cornerRadius="15dp"
            app:rippleColor="#FF5722" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>