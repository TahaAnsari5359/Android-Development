<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/question_bg"
    tools:context=".question10">

    <TextView
        android:id="@+id/textView"
        android:layout_width="360dp"
        android:layout_height="123dp"
        android:layout_marginTop="40dp"
        android:text="Which operating system is developed by Microsoft?"
        android:textAlignment="center"
        android:textColor="#F0EBEB"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/q10op1"
        android:layout_width="240dp"
        android:layout_height="65dp"
        android:backgroundTint="#182B63"
        android:text="Android"
        android:textColor="#EDE6E6"
        android:textSize="24sp"
        android:textStyle="bold"
        app:cornerRadius="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/textView"
        app:layout_constraintVertical_bias="0.228"
        app:rippleColor="#2196F3"
        app:strokeColor="#EFECEC"
        app:strokeWidth="2dp" />

    <Button
        android:id="@+id/q10op2"
        android:layout_width="240dp"
        android:layout_height="65dp"
        android:backgroundTint="#182B63"
        android:text="Linux"
        android:textColor="#EDE6E6"
        android:textSize="24sp"
        android:textStyle="bold"
        app:cornerRadius="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/textView"
        app:layout_constraintVertical_bias="0.37"
        app:rippleColor="#2196F3"
        app:strokeColor="#EDE6E6"
        app:strokeWidth="2dp" />

    <Button
        android:id="@+id/q10op3"
        android:layout_width="240dp"
        android:layout_height="65dp"
        android:backgroundTint="#182B63"
        android:text="macOS"
        android:textColor="#EDE6E6"
        android:textSize="24sp"
        android:textStyle="bold"
        app:cornerRadius="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/textView"
        app:layout_constraintVertical_bias="0.525"
        app:rippleColor="#2196F3"
        app:strokeColor="#EDE6E6"
        app:strokeWidth="2dp" />

    <Button
        android:id="@+id/q10op4"
        android:layout_width="240dp"
        android:layout_height="65dp"
        android:backgroundTint="#182B63"
        android:text="Windows"
        android:textColor="#EDE6E6"
        android:textSize="24sp"
        android:textStyle="bold"
        app:cornerRadius="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/textView"
        app:layout_constraintVertical_bias="0.669"
        app:rippleColor="#2196F3"
        app:strokeColor="#EDE6E6"
        app:strokeWidth="2dp" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="245dp"
        android:layout_height="52dp"
        android:layout_marginBottom="40dp"
        android:textAlignment="center"
        android:textSize="34sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/linearLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="310dp"
        android:layout_height="46dp"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.623"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/q10_prev"
            android:layout_width="145dp"
            android:layout_height="50dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#FFB52E"
            android:text="PREV"
            android:textColor="#161515"
            android:textSize="20sp"
            android:textStyle="bold"
            app:cornerRadius="15dp"
            app:rippleColor="#FF5722" />

        <Button
            android:id="@+id/q10_nxt"
            android:layout_width="145dp"
            android:layout_height="50dp"
            android:layout_marginEnd="40dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#FFB52E"
            android:text="NEXT"
            android:textColor="#0D0D0D"
            android:textSize="20sp"
            android:textStyle="bold"
            app:cornerRadius="15dp"
            app:rippleColor="#FF5722" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>