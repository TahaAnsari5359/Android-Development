<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_img"
    tools:context=".MainActivity" >

    <ListView
        android:id="@+id/notesList"
        android:layout_width="328dp"
        android:layout_height="183dp"
        android:layout_marginTop="16dp"

        android:background="@drawable/border"
        android:textAlignment="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.493"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView"
        app:layout_constraintVertical_bias="0.0" />

    <EditText
        android:id="@+id/editText"
        android:layout_width="207dp"
        android:layout_height="43dp"
        android:layout_marginTop="160dp"
        android:background="@drawable/border"
        android:ems="10"
        android:hint="Enter Title..."
        android:inputType="text"
        android:textAlignment="center"
        android:textColor="#0F0E0E"
        android:textColorHint="#1D1C1C"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/noteBox"
        android:layout_width="335dp"
        android:layout_height="113dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/border"
        android:gravity="top|start"
        android:hint="Write your note here..."
        android:inputType="textMultiLine"
        android:padding="16dp"
        android:textColor="#181717"
        android:textColorHint="#161616"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/editText" />

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="307dp"
        android:layout_height="75dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.596"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/notesList"
        app:layout_constraintVertical_bias="0.118">

        <Button
            android:id="@+id/button"
            android:layout_width="145dp"
            android:layout_height="52dp"
            android:backgroundTint="#EDBF4D"
            android:text="SAVE NOTE"
            android:textColor="#0B0B0B"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="20dp" />

        <Button
            android:id="@+id/button3"
            android:layout_width="145dp"
            android:layout_height="52dp"
            android:backgroundTint="#EBBE4D"
            android:text="CLEAR"
            android:textColor="#0B0B0B"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="20dp" />

    </LinearLayout>

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="------------  Added Notes  ------------"
        android:textColor="#141313"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/noteBox" />


</androidx.constraintlayout.widget.ConstraintLayout>